{
  "name": "dsh-vibe-paradigms",
  "version": "0.1.0",
  "description": "Out-of-tree working modes for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "dsh": "0.2.0-rc.2"
  },
  "packageManager": "pnpm@11.9.0",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./health": {
      "types": "./lib/health.d.ts",
      "default": "./lib/health.js"
    },
    "./package.json": "./package.json",
    "./chat": {
      "types": "./lib/chat.d.ts",
      "default": "./lib/chat.js"
    },
    "./workspace": {
      "types": "./lib/workspace.d.ts",
      "default": "./lib/workspace.js"
    },
    "./official-search": {
      "types": "./lib/search/official.d.ts",
      "default": "./lib/search/official.js"
    },
    "./search": {
      "types": "./lib/search/index.d.ts",
      "default": "./lib/search/index.js"
    },
    "./search-settings": {
      "types": "./lib/search/settings.d.ts",
      "default": "./lib/search/settings.js"
    },
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "generated/cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./generated/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --expose-internals --test tests/*.test.mjs",
    "compat": "pnpm build && node --expose-internals scripts/compat.mjs",
    "hmr": "pnpm build && node --expose-internals scripts/hmr.mjs",
    "audit:public": "node scripts/audit-public.mjs --history --pack",
    "prepack": "pnpm build && pnpm audit:public",
    "profile:create": "pnpm build && node scripts/create-profile.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-permission-presets": "0.2.0-rc.2",
    "@deepseek-ai/dsh-plan-mode": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-web": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web-fetch-http": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web-search-deepseek": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-deepseek-account": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/cordis-plugin-timer": "1.1.6",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-deepseek-account": "0.2.0-rc.2",
    "@deepseek-ai/dsh-hmr": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-permission-presets": "0.2.0-rc.2",
    "@deepseek-ai/dsh-plan-mode": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-web": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web-fetch-http": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web-search-deepseek": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@types/node": "24.10.1",
    "typescript": "6.0.3",
    "yaml": "2.8.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-deepseek-account": {
      "optional": true
    }
  }
}
